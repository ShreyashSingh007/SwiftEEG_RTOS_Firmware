/*
 * Application-level hardware choices, kept out of the board files because
 * they are firmware policy rather than facts about the board.
 */

/*
 * TIMER1 is the EEG sample timebase - see src/timebase.
 *
 * No Zephyr driver binds to this node: it is enabled purely so the
 * application can take the peripheral and read its IRQ number from
 * devicetree instead of hard-coding one.
 *
 * TIMER0 is not an option. MPSL owns it, along with RTC0, ECB, RADIO,
 * CLOCK, TEMP and PPI channels 19, 30 and 31.
 */
&timer1 {
	status = "okay";
};

/*
 * SPIM3 belongs to the AFE driver, not to Zephyr's SPI driver.
 *
 * The acquisition path needs the transfer started by PPI on the DRDY edge
 * with no code running in between, which Zephyr's SPI API cannot express.
 * src/afe owns the peripheral through the HAL instead.
 *
 * The node stays in the tree - pinctrl, cs-gpios and the ads1299 child are
 * all still read from devicetree. Only the driver binding is switched off.
 * SPI itself stays enabled for the IMU on spi2.
 */
&spi3 {
	status = "disabled";
};
